# Database (SQLite via Prisma ORM - runs locally with zero external services)
DATABASE_URL="file:./dev.db"

# Security & JWT Authentication (replace with strong random secrets in production)
JWT_SECRET="change-me-to-a-64-char-random-access-secret-in-production"
JWT_REFRESH_SECRET="change-me-to-a-64-char-random-refresh-secret-in-production"

# Company Branding & Defaults
COMPANY_NAME="SentinelShield Cyber"
DEFAULT_CURRENCY="AED"
AED_TO_USD_RATE="0.272294"

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000"

# Runtime URL injected by host environment
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
